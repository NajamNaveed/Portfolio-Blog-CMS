PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Jobs feature ---
# Free API key from https://console.groq.com — used to AI-filter fetched
# job listings against your saved criteria. Leave blank to skip AI
# filtering (jobs will still be fetched and criteria-matched, just
# without the extra AI relevance pass).
GROQ_API_KEY=

# A long random string you make up yourself (e.g. run `openssl rand -hex 32`).
# This is NOT your admin password — it's a separate secret that only the
# external daily scheduler (GitHub Actions) uses to trigger the job fetch,
# since that's a machine calling the API, not a logged-in admin.
JOB_CRON_SECRET=
