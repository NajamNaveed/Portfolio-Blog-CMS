PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI provider (used by job filtering, Ask About My Work, and AI-assisted project entry) ---
# Either "groq" or "gemini". All AI-powered features go through whichever
# you choose here — a single place to switch if one free tier runs low.
AI_PROVIDER=groq

# Free from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Free from https://aistudio.google.com (no credit card required for the
# Flash-family models within rate limits). Only used if AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Jobs feature ---
# A long random string you make up yourself (e.g. run `openssl rand -hex 32`).
# This is NOT your admin password — it's a separate secret that only the
# external daily scheduler (GitHub Actions) uses to trigger the job fetch,
# since that's a machine calling the API, not a logged-in admin.
JOB_CRON_SECRET=

# IANA timezone the "Daily Schedule" time in Jobs > Settings is interpreted
# in (e.g. Asia/Karachi, America/New_York). Defaults to UTC if left blank.
# Only affects the LOCAL scheduler below — it has no effect on the GitHub
# Actions cron, which you set separately in the workflow file (in UTC).
JOB_SCHEDULE_TIMEZONE=Asia/Karachi

# Optional — get notified when new jobs are found. Free via @BotFather on
# Telegram (create a bot, no business verification needed). Leave both
# blank to skip notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Max questions per visitor per day for the "Ask About My Work" widget,
# tracked per-IP in the database (survives restarts, not reset by a page
# refresh). No account system needed. Defaults to 15 if not set.
ASK_DAILY_LIMIT=15

# --- SEO ---
# Your PUBLIC frontend URL (e.g. https://najamnaveed.vercel.app), used to
# build correct links in the generated sitemap.xml. Falls back to
# CLIENT_URL if not set.
PUBLIC_SITE_URL=
